<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Pattern 03 Selenium Device Tiers" parallel="tests" thread-count="4">
  <test name="chrome">
    <parameter name="browserTier" value="chrome"/>
    <classes>
      <class name="com.yourapp.tests.SmokeTests"/>
      <class name="com.yourapp.tests.RegressionTests"/>
    </classes>
  </test>
  <test name="firefox">
    <parameter name="browserTier" value="firefox"/>
    <classes>
      <class name="com.yourapp.tests.SmokeTests"/>
      <class name="com.yourapp.tests.RegressionTests"/>
    </classes>
  </test>
  <test name="edge">
    <parameter name="browserTier" value="edge"/>
    <classes>
      <class name="com.yourapp.tests.SmokeTests"/>
      <class name="com.yourapp.tests.RegressionTests"/>
    </classes>
  </test>
  <test name="safari">
    <parameter name="browserTier" value="safari"/>
    <classes>
      <class name="com.yourapp.tests.SmokeTests"/>
    </classes>
  </test>
</suite>
